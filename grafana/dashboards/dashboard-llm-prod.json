{
  "title": "LLM Observability -- Production",
  "uid": "llm-prod",
  "schemaVersion": 38,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "tags": [
    "llm",
    "observability",
    "victoriametrics"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "vm-llm-prom"
        },
        "query": "label_values(llm_requests_total, model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "vm-llm-prom"
        },
        "query": "label_values(llm_requests_total{model=~\"$model\"}, provider)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pipeline_id",
        "label": "Pipeline",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "vm-llm-prom"
        },
        "query": "label_values(rag_retrieval_score_avg, pipeline_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Row 1 -- SLA / Health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "id": 100
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / min",
      "datasource": {
        "type": "prometheus",
        "uid": "vm-llm-prom"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ]
        },
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(llm_requests_total{model=~\"$model\",provider=~\"$provider\"}[1m])) * 60) or vector(0)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "P99 latency (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "vm-llm-prom"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2000
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ]
        },
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.99, sum by (le) (rate(llm_request_duration_ms_bucket{model=~\"$model\",provider=~\"$provider\"}[5m])))) or vector(0)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "vm-llm-prom"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.005
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ]
        },
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(llm_errors_total[5m])) / clamp_min(sum(rate(llm_requests_total[5m])), 1)) or vector(0)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "RAG retrieval score (z-score 30m baseline)",
      "datasource": {
        "type": "prometheus",
        "uid": "vm-llm-prom"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "description": "Live deviation of retrieval score vs its rolling 30m mean, normalized by 30m stddev. |z| > 2 = significant drift.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{index_id}}",
          "expr": "(abs(avg by (index_id)(rag_retrieval_score_avg) - avg by (index_id)(avg_over_time(rag_retrieval_score_avg[30m]))) / clamp_min(avg by (index_id)(stddev_over_time(rag_retrieval_score_avg[30m])), 0.01)) or vector(0)"
        }
      ]
    },
    {
      "type": "row",
      "title": "Row 2 -- Costs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "collapsed": false,
      "id": 200
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Cost rate by model (USD/min)",
      "datasource": {
        "type": "prometheus",
        "uid": "vm-llm-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "description": "Live cost rate per model. Uses rate() instead of increase() so panel populates immediately even on a fresh stack.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{model}} / {{provider}}",
          "expr": "(sum by (model, provider) (rate(llm_cost_usd_total{model=~\"$model\"}[5m])) * 60) or vector(0)"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Daily cost projection",
      "datasource": {
        "type": "prometheus",
        "uid": "vm-llm-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(llm_cost_usd_total[5m])) * 86400) or vector(0)"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Top 10 tenants -- 5m cost rate",
      "datasource": {
        "type": "prometheus",
        "uid": "vm-llm-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "description": "5m rate so the table populates from the first ingestion. Switch to increase(...[24h]) once the lab has run a full day.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "topk(10, sum by (tenant_id)(rate(llm_cost_usd_total[5m])) * 3600)"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Output / Input token ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "vm-llm-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(llm_tokens_total{type=\"output\"}[5m])) / clamp_min(sum(rate(llm_tokens_total{type=\"input\"}[5m])), 1)) or vector(0)"
        }
      ]
    },
    {
      "type": "row",
      "title": "Row 3 -- RAG quality",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "collapsed": false,
      "id": 300
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Retrieval score (live, by index)",
      "datasource": {
        "type": "prometheus",
        "uid": "vm-llm-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{index_id}}",
          "expr": "(avg by (index_id) (rag_retrieval_score_avg{pipeline_id=~\"$pipeline_id\"})) or vector(0)"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Context pressure P95 (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "vm-llm-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 12,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.85
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{pipeline_id}}",
          "expr": "(histogram_quantile(0.95, sum by (le, pipeline_id) (rate(rag_context_pressure_ratio_bucket{pipeline_id=~\"$pipeline_id\"}[5m])))) or vector(0)"
        }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Dropped chunks (% of requests, 5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "vm-llm-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * sum(rate(rag_chunks_dropped_total[5m])) / clamp_min(sum(rate(llm_requests_total[5m])), 1)) or vector(0)"
        }
      ]
    },
    {
      "type": "row",
      "title": "Row 4 -- GPU & throughput",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "collapsed": false,
      "id": 400
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "TTFT P95 (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "vm-llm-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2000
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{model}}",
          "expr": "(histogram_quantile(0.95, sum by (le, model) (rate(llm_ttft_ms_bucket{model=~\"$model\"}[5m])))) or vector(0)"
        }
      ]
    },
    {
      "id": 31,
      "type": "gauge",
      "title": "GPU memory utilisation",
      "datasource": {
        "type": "prometheus",
        "uid": "vm-llm-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ]
        },
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "GPU {{gpu}} / {{pod}}",
          "expr": "(DCGM_FI_DEV_FB_USED / clamp_min(DCGM_FI_DEV_FB_TOTAL, 1)) or vector(0)"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Tokens per Watt (output throughput / GPU power)",
      "datasource": {
        "type": "prometheus",
        "uid": "vm-llm-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{model}}",
          "expr": "(sum by (model)(rate(llm_tokens_total{type=\"output\"}[5m])) / clamp_min(scalar(avg(DCGM_FI_DEV_POWER_USAGE)), 1)) or vector(0)"
        }
      ]
    }
  ]
}